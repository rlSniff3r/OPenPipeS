---
tipo: target
targetName: {{ target.name }}
t_IP: "{{ target.ip }}"
t_openPorts: {{ target.ports | map(attribute='port') | list }}
t_services: {{ target.ports | map(attribute='service') | list }}
tags: [alvo, host]
pipeline_status: {{ target.pipeline_status }}
vuln_count: {{ target.vuln_count }}
last_updated: {{ target.last_updated }}
cssclasses:
  - purpleRed
  - whiteRed-rounded
  - yellowCab
  - flatBlue
{%- if target.screenshots %}
cover: "[[Screenshots/{{ target.screenshots[0].file_path }}]]"
{%- endif %}
---

{%- if target.whois %}
{%- set whois = target.whois | from_json %}

| 🌐 WHOIS | {{ target.name }} |
|-------|-------|
{%- for key, value in whois.items() %}
| {{ key }} | `{{ value }}` |
{%- endfor %}
{%- endif %}

{%- if target.is_alive %}

_Status_: 🟢 Ativo
_IPs_: {{ target.all_ips | join(", ") }}
_Última atualização_: {{ target.last_updated }}
{%- endif %}

---

## 💥 Vulnerabilidades
{%- if target.vulnerabilities %}

| Severidade | Título | CVSS | CVE |
|------------|--------|------|-----|
{%- for vuln in target.vulnerabilities %}
| {{ vuln.severity_emoji }} {{ vuln.severity }} | [[Vulnerabilidades/{{ vuln.filename }}|{{ vuln.title }}]] | {{ vuln.cvss_score or "N/A" }} | {{ vuln.cve_id or "—" }} |
{%- endfor %}
{%- else %}
*Nenhuma vulnerabilidade encontrada ainda.*
{%- endif %}

