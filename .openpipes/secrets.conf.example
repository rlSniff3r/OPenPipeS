# ------------------------------------------------------------------
# 🔐 OPenPipeS Secrets Template
# ------------------------------------------------------------------
# INSTRUÇÕES DE USO:
#
# 1. Copie este arquivo para o diretório de configuração:
#    cp secrets.conf.example ~/.openpipes/secrets.conf
#
# 2. Edite o arquivo e insira suas chaves de API:
#    nano ~/.openpipes/secrets.conf
#
# 3. IMPORTANTE: Restrinja as permissões de leitura (Segurança):
#    chmod 600 ~/.openpipes/secrets.conf
# ------------------------------------------------------------------

# [RECON] SecurityTrails API Key
# Necessário para: Enumeração passiva de subdomínios profunda.
# Obtenha em: https://securitytrails.com/
export securitytrailskey=""

# [AI] OpenAI API Key
# Necessário para: Enriquecimento de vulnerabilidades e análise de contexto.
# Obtenha em: https://platform.openai.com/api-keys
export OPENAI_API_KEY=""

# [AI] Gemini API Key
# Necessário para Enriquecimento de vulnerabilidades gratuitamente.
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY="SUA_CHAVE_AQUI"

# [OSINT] Google API Key
# Necessário para: Google Dorking automatizado e busca de metadados.
# Obtenha em: https://console.cloud.google.com/apis/credentials
export GOOGLE_API_KEY=""

# [OSINT] Google Custom Search Engine (CSE) ID
# Necessário para: Contexto de busca do Google Dorks.
# Obtenha em: https://programmablesearchengine.google.com/
export GOOGLE_CSE_ID=""

# [OSINT] SerpApi Key
# Necessário para: Scraping avançado de resultados de busca sem bloqueio.
# Obtenha em: https://serpapi.com/
export SERPAPI_KEY=""

# [WEB] Usuário e Senha Dasboard Web
# Necessário para: Autenticação na Dashboard Web do Framework
# Configure antes de usar.
export WEB_USER=admin
export WEB_PASS=admin123

